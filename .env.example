# DeepSeek v4 API key — required for invoice field extraction.
# Get one at https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Optional: override the default DeepSeek model
DEEPSEEK_MODEL=deepseek-chat

# Optional: log level (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# Optional: where uploaded PDFs are staged during processing (default: ./uploads)
UPLOAD_DIR=./uploads